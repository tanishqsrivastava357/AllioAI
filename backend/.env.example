PORT=3000
GOOGLE_CLIENT_ID=put-your-google-client-id-here.apps.googleusercontent.com
GITHUB_CLIENT_ID=put-your-github-oauth-client-id-here
GITHUB_CLIENT_SECRET=put-your-github-oauth-client-secret-here
DATABASE_URL=postgresql://username:password@hostname:5432/allioai
SESSION_SECRET=replace-this-with-at-least-32-random-characters
NODE_ENV=production
SITE_URL=https://your-production-domain.example
DB_POOL_MAX=10
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional provider CA certificate, with newlines escaped as \n
DB_SSL_CA=
GEMINI_API_KEY=put-your-google-gemini-api-key-here
RAZORPAY_KEY_ID=your-razorpay-public-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_MONTHLY_PLAN_ID=your-razorpay-monthly-plan-id
RAZORPAY_ANNUAL_PLAN_ID=your-razorpay-annual-plan-id
# Optional model overrides. Defaults power the AllioGPT 1.0 model family.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_CREATIVE_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
