PORT=3000
GOOGLE_CLIENT_ID=put-your-google-client-id-here.apps.googleusercontent.com
DATABASE_URL=postgresql://username:password@hostname:5432/allioai
SESSION_SECRET=replace-this-with-at-least-32-random-characters
NODE_ENV=production
SITE_URL=https://your-production-domain.example
DB_POOL_MAX=10
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional provider CA certificate, with newlines escaped as \n
DB_SSL_CA=
OPENROUTER_API_KEY=put-your-openrouter-api-key-here
# Optional model overrides. Defaults are selected by AllioAI's role-based model configs.
OPENROUTER_FAST_MODEL=google/gemini-2.5-flash
OPENROUTER_PRO_MODEL=google/gemini-2.5-pro
OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1-0528
OPENROUTER_VISION_MODEL=google/gemini-2.5-pro
OPENROUTER_CREATIVE_MODEL=anthropic/claude-sonnet-4
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
