{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/app/**",
          "backend/package.json",
          "backend/package-lock.json",
          "frontend/src/pages/**",
          "frontend/src/styles/**",
          "frontend/src/scripts/**",
          "frontend/src/assets/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
